# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing secrets — never commit
/android/key.properties
/android/keystore/
*.jks
*.keystore

# Release artifacts
/dist/

# Rust / Rinf native build artifacts
/native/hub/target/
/native/**/target/
.rinf/

# Firebase credentials — google-services.json is required locally to build
# but should not drift between portfolio builds in git. Keep the current
# committed copy; new rotations go through secret-store, not a PR.
# (Entry intentionally commented until the next rotation to not break the
#  existing checked-in copy.)
# android/app/google-services.json

# Rust vault build artefacts — the .so files under android/app/src/main/jniLibs
# ARE committed (shipped with the APK). The intermediate target/ is not.
native/*/target/
