<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written adaptive icon, kept in sync with drawable-anydpi-v26/
     ic_splash_logo.xml so the launcher and the Android 12+ splash render
     identically. flutter_launcher_icons is configured without the adaptive
     keys so it never overwrites this file on the next run. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="17%" />
    </foreground>
</adaptive-icon>
